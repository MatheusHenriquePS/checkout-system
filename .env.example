# Copie para .env: cp .env.example .env
# Portas no host (faixa 808x). API e Worker são processos separados; 8080 é só a API HTTP.

# --- API (Etapa 2+) ---
API_HOST_PORT=8080

# --- PostgreSQL ---
POSTGRES_USER=checkout
POSTGRES_PASSWORD=checkout_secret
POSTGRES_DB=checkout
POSTGRES_HOST_PORT=8081

# --- Redis ---
REDIS_HOST_PORT=8082

# --- RabbitMQ (AMQP + UI precisam de 2 portas) ---
RABBITMQ_USER=checkout
RABBITMQ_PASSWORD=checkout_secret
RABBITMQ_VHOST=checkout
RABBITMQ_HOST_PORT=8083
RABBITMQ_MANAGEMENT_HOST_PORT=8084
CHECKOUT_QUEUE_NAME=checkout.orders
WORKER_PREFETCH=1

# --- Apps (Etapa 2+) — URLs no host; dentro do Docker use hostnames postgres/redis/rabbitmq ---
DATABASE_URL=postgresql://checkout:checkout_secret@localhost:8081/checkout
REDIS_URL=redis://localhost:8082
RABBITMQ_URL=amqp://checkout:checkout_secret@localhost:8083/checkout
NODE_ENV=development

# Idempotência (Redis) — TTL do resultado cacheado e lock enquanto processa
IDEMPOTENCY_TTL_SECONDS=86400
IDEMPOTENCY_LOCK_SECONDS=120

# --- Worker — gateway de pagamento simulado (Etapa 7) ---
PAYMENT_SIMULATED_LATENCY_MS=150
PAYMENT_FAIL_RATE=0.15
PAYMENT_TIMEOUT_MS=5000
PAYMENT_MAX_ATTEMPTS=4
PAYMENT_BACKOFF_BASE_MS=500
PAYMENT_BACKOFF_MAX_MS=15000
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_COOLDOWN_MS=30000

# --- k6 (Etapa 8) — opcional; também passa via CLI ---
# K6_BASE_URL=http://127.0.0.1:8080
# K6_PRODUCT_ID=ff509508-99e9-48cb-9cc6-1a4cd7d5bab0
# Dentro do Docker (API/Worker):
#   DATABASE_URL=postgresql://checkout:checkout_secret@postgres:5432/checkout
#   REDIS_URL=redis://redis:6379
#   RABBITMQ_URL=amqp://checkout:checkout_secret@rabbitmq:5672/checkout
